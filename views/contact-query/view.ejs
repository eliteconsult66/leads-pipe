<%- include("../partials/boilerplate.ejs") %>

    <%- include("../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../partials/sidebar.ejs") %>
                <!-- Page sidebar end-->
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h3>Contact Enquiries</h3>
                                </div>
                                <div class="enq-filter">
                                    <div class="filter-top">
                                        <a href="/contact-query/export-csv">Export All Enquires CSV</a>
                                        <a href="/contact-query/export-today-csv">Export Today Enquires CSV</a>
                                    </div>
                                    <div class="filter-bot">
                                        <form action="/contact-query/export-date-csv" method="GET">
                                            <div class="row align-items-end">
                                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12">
                                                    <label for="">From</label>
                                                    <input class="form-control" type="date" name="fromDate" required>
                                                </div>
                                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12">
                                                    <label for="">To</label>
                                                    <input class="form-control" type="date" name="toDate" required>
                                                </div>
                                                <div class="col-xl-4 col-lg-4 col-md-12">
                                                    <button class="dat-csv-btn">
                                                        Export CSV
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Container-fluid starts-->
                    <%- include("../partials/flash.ejs") %>
                        <%- include("../partials/model.ejs") %>
                            <div class="container-fluid edit-profile">
                                <div class="row">
                                    <div class="col-xl-12">
                                        <div class="card-body rolecard-body">
                                            <div class="table-responsive">
                                                <table class="display" id="basic-1">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>Name</th>
                                                            <th>Email</th>
                                                            <th>Status</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (allEnquiries.length===0) { %>
                                                            <% } else { %>
                                                                <% allEnquiries.forEach((query, index)=> { %>
                                                                    <tr>
                                                                        <td>
                                                                            <%= index + 1 %>
                                                                        </td>
                                                                        <td>
                                                                            <%= query.fullname %>
                                                                        </td>
                                                                        <td>
                                                                            <%= query.email %>
                                                                        </td>
                                                                        <td>
                                                                            <button
                                                                                class="btn btn-sm status-btn <%= query.status === 'Unread' ? '' : 'flipped' %>"
                                                                                data-url="/admin/contact-query/<%= query._id %>/toggle-read-status">
                                                                                <span
                                                                                    class="read flip-front">Unread</span>
                                                                                <span class="read flip-back">Read</span>
                                                                            </button>
                                                                        </td>
                                                                        <td>
                                                                            <ul class="action">
                                                                                <li class="view"> <a title="View"
                                                                                        href="/admin/contact-query/<%= query._id %>/show"><i
                                                                                            class="fa-regular fa-eye"></i></a>
                                                                                </li>
                                                                                <li class="delete">
                                                                                    <button type="button"
                                                                                        data-url="/admin/contact-query/<%= query._id %>?_method=DELETE"
                                                                                        class="delete-btn"
                                                                                        data-id="<%= query._id %>"
                                                                                        data-name="<%= query.name %>"
                                                                                        data-bs-toggle="modal"
                                                                                        data-bs-target="#deleteModel">
                                                                                        <i
                                                                                            class="fa-solid fa-trash"></i>
                                                                                    </button>

                                                                                </li>
                                                                            </ul>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Container-fluid ends-->
                </div>

                <%- include("../partials/footer.ejs") %>