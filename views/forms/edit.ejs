<%- include("../partials/boilerplate.ejs") %>

    <%- include("../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../partials/sidebar.ejs") %>
                <!-- Page sidebar end-->
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-sm-12">
                                <h3>Edit Form</h3>
                            </div>
                        </div>
                    </div>
                    <%- include("../partials/flash.ejs") %>
                        <!-- Container-fluid starts-->
                        <div class="container-fluid edit-profile">
                            <div class="row">
                                <div class="col-xl-12">
                                    <form class="card" method="POST" action="/forms/<%= form._id %>/?_method=PUT">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Select Landing Page</label>
                                                        <select name="landingPage" class="form-select" required>
                                                            <% landingPages.forEach(landingPage=> { %>
                                                                <option value="<%= landingPage._id %>"
                                                                    <%=landingPage._id.toString()===form.landingPage.toString()
                                                                    ? 'selected' : '' %>
                                                                    >

                                                                    <%= landingPage.name %>

                                                                </option>

                                                                <% }) %>


                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Form Name</label>
                                                        <input class="form-control" required name="name"
                                                            value="<%= form.name %>" id="formName" type="text">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">slug<span
                                                                style="color: red;">*</span></label>
                                                        <input class="form-control" required readonly name="slug"
                                                            value="<%= form.slug %>" id="formSlug" type="text">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Fluent Form Id</label>
                                                        <input class="form-control" min="1"
                                                            value="<%= form.fluentFormId %>" required
                                                            name="fluentFormId" type="number">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-footer text-end">
                                            <button class="btn btn-primary" type="submit">Update Form</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <!-- Container-fluid ends-->
                </div>

                <%- include("../partials/footer.ejs") %>