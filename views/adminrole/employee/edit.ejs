<%- include("../../partials/boilerplate.ejs") %>

    <%- include("../../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../../partials/sidebar.ejs") %>
                <!-- Page sidebar end-->
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-sm-12">
                                <h3>Edit Employee</h3>
                            </div>
                        </div>
                    </div>
                    <!-- Container-fluid starts-->
                    <div class="container-fluid edit-profile">
                        <div class="row">
                            <div class="col-xl-12">
                                <form class="card" method="POST"
                                    action="/employee/<%= employee._id %>/edit?_method=PUT">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="mb-3">
                                                    <label class="form-label">Select Role</label>
                                                    <select name="role" class="form-control">
                                                        <option value="">Select Role</option>

                                                        <% roles.forEach(role=> { %>

                                                            <option value="<%= role._id %>" <%=employee.role &&
                                                                employee.role.toString()===role._id.toString()
                                                                ? 'selected' : '' %>>
                                                                <%= role.name %>
                                                            </option>

                                                            <% }) %>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="mb-3">
                                                    <label class="form-label">Employee Name</label>
                                                    <input class="form-control" value="<%= employee.name %>" name="name"
                                                        type="text">
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="mb-3">
                                                    <label class="form-label">Employee Username</label>
                                                    <input class="form-control" value="<%= employee.username %>" name="username"
                                                        type="text">
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="mb-3">
                                                    <label class="form-label">Employee Email</label>
                                                    <input class="form-control" value="<%= employee.email %>"
                                                        name="email" type="email">
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="mb-3">
                                                    <label class="form-label">Employee Password</label>
                                                    <input class="form-control" value="" name="password" type="password"
                                                        placeholder="Leave blank to keep current password">
                                                </div>
                                            </div>
                                            <!-- <div class="col-lg-12">
                                                <div class="mb-3">
                                                    <label class="form-label">Select Status</label>
                                                    <select name="status" class="form-control">
                                                        <option value="active" <%=employee.status==='active'
                                                            ? 'selected' : '' %>>
                                                            Active
                                                        </option>

                                                        <option value="inactive" <%=employee.status==='inactive'
                                                            ? 'selected' : '' %>>
                                                            Inactive
                                                        </option>
                                                    </select>
                                                </div>
                                            </div> -->

                                        </div>
                                    </div>
                                    <div class="card-footer text-end">
                                        <button class="btn btn-primary" type="submit">Update Employee</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <!-- Container-fluid ends-->
                </div>

                <%- include("../../partials/footer.ejs") %>