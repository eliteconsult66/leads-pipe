<%- include("../partials/boilerplate.ejs") %>

    <%- include("../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../partials/sidebar.ejs") %>
                <!-- Page sidebar end-->
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-sm-6">
                                <h3>Change Password</h3>
                            </div>
                        </div>
                    </div>
                    <!-- Container-fluid starts-->
                     <%- include("../partials/flash.ejs")  %>
                    <div class="container-fluid edit-profile">
                        <div class="row">
                            <div class="col-xl-12">
                                <form class="card" method="POST" action="/myaccount?_method=PUT">
                                    <div class="card-header">
                                        <h4 class="card-title mb-0">Edit Admin Profile</h4>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="mb-3">
                                                    <label class="form-label">Name</label>
                                                    <input class="form-control" value="<%= currentUser.name %>" name="name" type="text" placeholder="Name">
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="mb-3">
                                                    <label class="form-label">Username</label>
                                                    <input class="form-control" value="<%= currentUser.username %>" name="username" type="text" placeholder="Username">
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="mb-3">
                                                    <label class="form-label">Email</label>
                                                    <input class="form-control" value="<%= currentUser.email %>" name="email" type="email" placeholder="Email">
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="mb-3 position-relative">
                                                    <label class="form-label">Current Password</label>
                                                    <input class="form-control" name="currentpassword" type="password" placeholder="Current Password">
                                                    <div class="show-hide"><span class=""></span></div>
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div class="mb-3 position-relative">
                                                    <label class="form-label">New Password</label>
                                                    <input class="form-control" name="newpassword" type="password" placeholder="New Password">
                                                    <div class="show-hide2"><span class=""></span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer text-end">
                                        <button class="btn btn-primary" type="submit">Update Profile</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <!-- Container-fluid ends-->
                </div>

        <%- include("../partials/footer.ejs") %>